/**
 * โลโก้ / favicon ของ PerformPro
 * - หน้าเว็บใช้ไอคอนจาก Supabase Storage (bucket public: LOGO_BUCKET, ไฟล์: LOGO_PATH)
 * - รัน setupLogo() จาก Editor ครั้งเดียว เพื่อสร้าง bucket (ถ้ายังไม่มี) และอัปโหลดไฟล์ด้านล่าง
 * - ถ้าต้องการใช้ไฟล์อื่น ตั้ง Script Property LOGO_URL เป็น URL ของรูป PNG ได้เลย
 * ต้นฉบับ: assets/logo.svg (LOGO_PNG_B64 = assets/logo-128.png)
 */
var LOGO_BUCKET = 'pformpro-public';
var LOGO_PATH = 'brand/favicon.png';

// URL ของ favicon: LOGO_URL (ถ้าตั้งไว้) หรือ public URL ใน Supabase Storage · คืน '' ถ้ายังไม่ได้ตั้งค่า Supabase
function logoUrl_() {
  var p = PropertiesService.getScriptProperties();
  var custom = p.getProperty('LOGO_URL');
  if (custom) return custom;
  var url = p.getProperty('SUPABASE_URL');
  return url ? url.replace(/\/$/, '') + '/storage/v1/object/public/' + LOGO_BUCKET + '/' + LOGO_PATH : '';
}

// รันจาก Editor: สร้าง bucket public แล้วอัปโหลด/ทับไฟล์โลโก้ (รันซ้ำได้)
function setupLogo() {
  try { storage_('get', 'bucket/' + LOGO_BUCKET); }
  catch (e) { storage_('post', 'bucket', JSON.stringify({ id: LOGO_BUCKET, name: LOGO_BUCKET, public: true })); Logger.log('✓ สร้าง bucket ' + LOGO_BUCKET); }
  var c = cfg_();
  var res = UrlFetchApp.fetch(c.url + '/storage/v1/object/' + LOGO_BUCKET + '/' + LOGO_PATH, {
    method: 'post', muteHttpExceptions: true, contentType: 'image/png',
    headers: { apikey: c.key, Authorization: 'Bearer ' + c.key, 'x-upsert': 'true', 'cache-control': 'max-age=86400' },
    payload: Utilities.newBlob(Utilities.base64Decode(LOGO_PNG_B64), 'image/png', 'favicon.png')
  });
  if (res.getResponseCode() >= 300) throw new Error('อัปโหลดโลโก้ไม่สำเร็จ ' + res.getResponseCode() + ': ' + res.getContentText());
  Logger.log('✓ อัปโหลดโลโก้แล้ว: ' + logoUrl_());
}

var LOGO_PNG_B64 = '';
