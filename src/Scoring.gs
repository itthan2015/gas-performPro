  GR_SUP: [['5','ดีเยี่ยม','≥ 90','ประสิทธิภาพ ≥90% ขึ้นไป, มีความสนใจและการพัฒนาอย่างดีมาก, ผลงาน-ผลการกระทำดีเลิศกว่าเป้าหมายที่กำหนด'],['4','ดี','85 – 89.99','ประสิทธิภาพ ≥85%, มีความสนใจและการพัฒนาเป็นอย่างดี, ผลงานดีและเป็นไปตามเป้าหมายที่กำหนดไว้'],['3','ปานกลาง','75 – 84.99','ประสิทธิภาพ ≥75%มีความสนใจและการพัฒนาตามหน้าที่ที่ตนเองได้รับมอบหมาย หรือเฉพาะกิจกรรมที่ตนเองสนใจ'],['2','ต่ำกว่ามาตรฐาน','60.01 – 74.99','ประสิทธิภาพค่อนข้างต่ำ ≤ 74% หรือต้องใช้คำสั่งหรือการควบคุมติดตามอย่างใกล้ชิด/เคยได้รับการแนะนำตักเตือนแล้ว/มีการปรับปรุงพัฒนาเล็กน้อย'],['1','ควรปรับปรุง','≤ 60','ประสิทธิภาพต่ำ, ≤60 ไม่มีส่วนร่วม-ต่อต้าน-หลีกหนีกิจกรรมต่าง ๆ ของหน่วยงาน/เคยได้รับการว่ากล่าวตักเตือนแล้ว/ไม่มีการปรับปรุงพัฒนา']],
  STATUS: { none:['ยังไม่ประเมิน','tag-neutral'], draft:['ร่าง','tag-outline'], returned:['ส่งกลับแก้ไข','tag-outline'], div:['รออนุมัติระดับฝ่าย','tag-accent'], exec:['รออนุมัติระดับบริหาร','tag-accent'], ack:['รอพนักงานรับทราบ','tag-accent'], hr:['รอฝ่ายบุคคลบันทึก','tag-accent'], done:['เสร็จสิ้น','tag-neutral'] },
