// สายอนุมัติ: เกรด 5 ขึ้นไป หรือตำแหน่งหัวหน้าฝ่าย → ข้ามขั้นอนุมัติระดับฝ่าย ส่งผู้บริหารโดยตรง
// นอกนั้น (รวมเกรด 4 เช่น หัวหน้าแผนก) ต้องผ่านหัวหน้าฝ่ายอนุมัติก่อน
function skipDivStep(grade, pos) { return Number(grade) >= 5 || /หัวหน้าฝ่าย/.test(String(pos || '')); }

// เลือกแบบฟอร์มตามเกรด + ตำแหน่ง (HR กำหนดเองได้ที่ eval_form)
function pickForm(grade, pos, override) {
  if (override && SCORING.FORMS[override]) return override;
  grade = Number(grade) || 1; pos = String(pos || '');
  if (grade >= 4) return 'g45';
  if (grade === 1) return 'g1';
  if (grade === 2) return /ผู้คุม|คุมงาน|โฟร์แมน|forem/i.test(pos) ? 'g2_sup' : /ธุรการ|เสมียน|admin|บัญชี|จัดซื้อ|บุคคล|เจ้าหน้าที่/i.test(pos) ? 'g2_adm' : 'g2_tech';
  return /รองหัวหน้า/.test(pos) ? 'g3_dep' : /ช่างเทคนิค|technician/i.test(pos) ? 'g3_techn' : /ช่าง/.test(pos) ? 'g3_tech2' : 'g3_off';
}
function formOf(f) { return SCORING.FORMS[f] || SCORING.FORMS[f === 'sup' ? 'g45' : 'g1']; }
function formKey(f) { return SCORING.FORMS[f] ? f : (f === 'sup' ? 'g45' : 'g1'); }
function gradeScale(f) { return formOf(f).grade === '4–5' ? SCORING.GR_SUP : SCORING.GR_NEW; }

function blankScores() {
  return { lv:[null,null,null,null,null,null,null,null], sc:[null,null,null,null,null,null,null,null], reasons:['','','','','','','',''], courses:['',''], comments:['',''] };
}
function normScores(sc) {
  sc = sc || {}; var b = blankScores();
  ['lv','sc','reasons'].forEach(function (k) { var a = Array.isArray(sc[k]) ? sc[k].slice() : []; while (a.length < 8) a.push(k === 'reasons' ? '' : null); sc[k] = a; });
  ['courses','comments'].forEach(function (k) { var a = Array.isArray(sc[k]) ? sc[k].slice() : []; while (a.length < 2) a.push(''); sc[k] = a; });
  return sc;
}

function discRows(att) {
  att = att || {};
  var n = function (k) { return Number(att[k] || 0); };
  var leave = n('personal') + n('sick'), hrs = Math.round(n('late') / 60 * 100) / 100, abs = n('absent') + n('verbal') + n('written');
  return [
    { k:'leave', l:'ลากิจ + ลาป่วย รวมกัน', v:leave, u:'วัน', note:'ลากิจ ' + n('personal') + ' · ลาป่วย ' + n('sick'), rule:'เกิน 3 วัน หักวันละ 1', ded: Math.max(0, leave - 3) },
    { k:'late', l:'มาสาย', v:hrs, u:'ชม.', note: n('late') + ' นาที', rule:'หักชั่วโมงละ 0.5', ded: hrs * 0.5 },
    { k:'absent', l:'ขาดงาน + ใบเตือน', v:abs, u:'วัน/ฉบับ', note:'ขาดงาน ' + n('absent') + ' · ใบเตือนวาจา ' + n('verbal') + ' · ลายลักษณ์อักษร ' + n('written'), rule:'หักวันละ / ฉบับละ 5', ded: abs * 5 }
  ];
}

// W (น้ำหนัก) ไม่ใช้แล้ว — คงพารามิเตอร์ไว้เพื่อความเข้ากันได้
function calcScore(form, att, sc, W) {
  var F = formOf(form); sc = normScores(sc);
  var parts = F.c.map(function (p, i) {
    var raw = sc.sc[i], o = sc.lv[i] != null ? p.o[sc.lv[i]] : null;
    if (raw != null && (!o || Number(raw) < o[1] || Number(raw) > o[2])) raw = null; // คะแนนต้องอยู่ในช่วงของลักษณะผลที่เลือก (กันข้อมูลจากแบบฟอร์มเดิม)
    return { no:i + 1, title:p.t, short:p.t, sub:p.s, weight:p.max, max:p.max, raw:raw, done: raw != null, weighted: raw != null ? Number(raw) : 0 };
  });
  var rows = discRows(att), ded = rows.reduce(function (s, r) { return s + r.ded; }, 0);
  var attRaw = Math.max(0, Math.round((F.disc - ded) * 100) / 100);
  parts.push({ no:F.c.length + 1, title:'การรักษาระเบียบวินัย พิจารณาจากสถิติมาทำงาน', short:'การรักษาระเบียบวินัย', weight:F.disc, max:F.disc, raw:attRaw, done:true, weighted:attRaw, att:true, ded:ded });
  var full = parts.reduce(function (s, p) { return s + p.max; }, 0);
  var total = Math.round(parts.reduce(function (s, p) { return s + p.weighted; }, 0) * 100) / 100;
  var G = gradeScale(form), g;
  if (G === SCORING.GR_NEW) g = total >= 95 ? 0 : total >= 85 ? 1 : total >= 80 ? 2 : total >= 75 ? 3 : total >= 70 ? 4 : total >= 60 ? 5 : 6;
  else g = total >= 90 ? 0 : total >= 85 ? 1 : total >= 75 ? 2 : total <= 60 ? 4 : 3;
  return { form:formKey(form), parts:parts, rows:rows, attRaw:attRaw, attMax:F.disc, full:full, total:total, grade:G[g][0], label:G[g][1],
    complete: parts.every(function (p) { return p.done; }),
    missing: parts.filter(function (p) { return !p.done; }).map(function (p) { return 'ข้อ ' + p.no + ' ' + p.short; }) };
}
